{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["outputs"],
  "properties": {
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "sixToMe", "meToSix"],
        "properties": {
          "caseId": { "type": "string", "minLength": 1 },
          "sixToMe": { "type": "string", "minLength": 1 },
          "meToSix": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}

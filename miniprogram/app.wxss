@import "assets/fonts/classic.wxss";
@import "assets/fonts/system.wxss";
page {
  height: 100%;
  color: #e4e9e9;
  background: #000000;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Noto Sans CJK SC", "Microsoft YaHei", sans-serif;
  font-weight: 400;
  -webkit-font-smoothing: antialiased;
}
button { margin: 0; padding: 0; color: inherit; font: inherit; background: transparent; border-radius: 0; line-height: inherit; }
button::after { border: 0; }
button[disabled] { color: #647071; background: transparent; }
view, button, text, textarea, scroll-view { box-sizing: border-box; }
text, textarea, input { font-family: inherit; font-weight: 400; }

<view class="experience">
  <view id="motion-preference" class="motion-preference" aria-hidden="true" />
  <canvas type="webgl" id="ribbon" hidden="{{graphicsError || snapshotReady}}" class="ribbon" style="top: {{sceneTop}}px; height: {{sceneHeight}}px" catchtap="onCanvasTap" catchtouchstart="onTouchStart" catchtouchmove="onTouchMove" catchtouchend="onTouchEnd" catchtouchcancel="onTouchCancel" binderror="graphicsFailed" aria-label="流动经文，轻点停驻，拖动回看" />
  <canvas type="2d" id="glyph-atlas" class="glyph-atlas" aria-hidden="true" />
  <image wx:for="{{shots}}" wx:key="token" class="scene-shot {{item.visible ? 'scene-shot--visible' : ''}} {{item.blend ? 'scene-shot--blend' : ''}}" src="{{item.src}}" mode="scaleToFill" style="top: {{sceneTop}}px; height: {{sceneHeight}}px; transform: translateY({{-sceneShift}}px)" data-token="{{item.token}}" bindload="onSnapshotLoad" binderror="onSnapshotError" catchtap="onCanvasTap" catchtouchstart="onTouchStart" catchtouchmove="onTouchMove" catchtouchend="onTouchEnd" catchtouchcancel="onTouchCancel" aria-hidden="true" />

  <view wx:if="{{!ready}}" class="arrival" aria-role="status"><text>六经注我</text></view>
  <view wx:if="{{error}}" class="arrival error-state" aria-role="alert"><text>{{error}}</text><button class="text-button" bindtap="retry">重新展开</button></view>
  <view wx:if="{{graphicsError && active}}" class="fallback-anchor" style="top: {{centerY}}px; transform: translateY({{-sceneShift}}px)"><text>{{active.quote}}</text></view>

  <view wx:if="{{active}}" class="reading-layer {{readingVisible ? 'reading-layer--visible' : ''}}" style="top: {{readerTop}}px; transform: translateY({{-sceneShift}}px)" aria-hidden="{{!readingVisible}}">
    <scroll-view class="reading-scroll" style="height: {{readerHeight + sceneShift}}px" scroll-y="{{true}}" scroll-top="{{readingScroll}}" bindscroll="onReadingScroll" enhanced="{{true}}" show-scrollbar="{{false}}" catchtap="swallow">
      <text class="reading-context" user-select="{{true}}">{{active.passageQuote}}</text>
      <view class="reading-block"><text class="eyebrow">句意</text><text class="reading-meaning">{{active.meaning}}</text></view>
      <view class="reading-block reflection"><text class="eyebrow">此刻 · 示例解读</text><text class="reading-reflection">{{active.reflection}}</text></view>
      <view wx:if="{{sourceMounted}}" class="source-details {{sourceOpen ? 'source-details--visible' : ''}}">
        <view class="source-heading"><text>《{{active.source}}》</text><text class="source-chapter">{{active.chapterLabel}}</text></view>
        <text class="source-fulltext" user-select="{{true}}"><text wx:for="{{sourceParts}}" wx:key="index" class="{{item.selected ? 'source-selected' : ''}}">{{item.text}}</text></text>
        <text class="source-note">以上为经典原文；句意与此刻解读为人工整理的示例。</text>
      </view>
      <view wx:if="{{sourceOpen || graphicsError}}" class="passage-navigation"><button bindtap="previous" aria-label="上一段完整经文">上一段</button><text>{{ordinal}} / {{total}}</text><button bindtap="next" aria-label="下一段完整经文">下一段</button></view>
    </scroll-view>
  </view>

  <view class="gesture-hint {{hintVisible && ready && !paused && !overlay ? 'gesture-hint--visible' : ''}}" style="bottom: {{bottomInset + 16}}px">轻点停驻，读懂这一句</view>
  <view class="footer {{!overlay && paused ? 'footer--visible' : ''}}" style="padding-bottom: {{bottomInset}}px" aria-hidden="{{!!overlay || !paused}}">
    <button class="text-button seed-control" bindtap="openSeed" disabled="{{loading}}" aria-label="写下一念">一念</button>
    <button class="text-button source-control" bindtap="openSource" disabled="{{loading}}">{{sourceOpen ? '收起原文' : '原文'}}</button>
    <button class="text-button pause-control" bindtap="onPauseControl" disabled="{{loading}}">{{graphicsError ? '恢复流动' : '继续'}}</button>
  </view>

  <view wx:if="{{overlay}}" class="backdrop {{overlayVisible ? 'backdrop--visible' : ''}}" bindtap="closeOverlay" catchtouchmove="swallow" />
  <view wx:if="{{overlay === 'seed'}}" class="sheet {{overlayVisible ? 'sheet--visible' : ''}}" style="transform: translateY({{(overlayVisible ? 0 : 36) - keyboardHeight}}px)" catchtap="swallow" catchtouchmove="swallow">
    <view class="sheet-heading"><text class="eyebrow">从一念开始</text><button class="close-sheet" bindtap="closeOverlay" aria-label="关闭输入">收起</button></view>
    <text class="sheet-title">此刻，什么萦绕着你？</text>
    <textarea class="seed-input" value="{{draft}}" bindinput="onSeedInput" placeholder="写下心里的那一句…" placeholder-class="input-placeholder" maxlength="120" focus="{{inputFocus}}" adjust-position="{{false}}" show-confirm-bar="{{false}}" bindkeyboardheightchange="onKeyboardHeight" aria-label="最初的一念" />
    <view class="suggestions"><button data-seed="我想让心慢下来" bindtap="usePrompt">让心慢下来</button><button data-seed="如何与他人相处" bindtap="usePrompt">与他人相处</button><button data-seed="我想开始，却总在犹豫" bindtap="usePrompt">迈出第一步</button></view>
    <button class="enter-flow" bindtap="submitSeed" disabled="{{!draft || loading}}">{{loading ? '正在展开' : '让它流动'}}</button>
  </view>
</view>

.experience { position: relative; width: 100%; height: 100vh; overflow: hidden; background: #000; }
.motion-preference { position: absolute; width: 0; height: 0; overflow: hidden; pointer-events: none; opacity: 1; }
.chain-reading-nav { display: flex; justify-content: space-between; margin-top: 6px; }
.chain-reading-nav button { margin: 0; padding: 0; min-height: 44px; font-size: 12px; line-height: 44px; color: #8e9a9b; background: transparent; }
.chain-status { position: absolute; z-index: 4; left: 32px; right: 32px; display: flex; align-items: center; justify-content: space-between; font-size: 12px; line-height: 1.8; color: #9aa9aa; background: #000; }
.chain-status button { font-size: 12px; min-width: 48px; min-height: 44px; line-height: 44px; }
.path-step { display: block; width: 100%; margin: 0; padding: 16px 0; text-align: left; font-size: 16px; color: #dde1dc; background: transparent; border-bottom: 1px solid rgba(255,255,255,.08); }
.path-focus { display: block; margin-top: 6px; font-size: 13px; line-height: 1.8; color: #93a1a2; }
.ribbon, .scene-shot { position: absolute; left: 0; width: 100%; }
.ribbon { z-index: 0; }
.glyph-atlas { position: absolute; left: -10000px; top: 0; width: 2px; height: 2px; pointer-events: none; }
.scene-shot { z-index: 1; opacity: 0; transition: transform 340ms cubic-bezier(0.32, 0.72, 0, 1); }
.scene-shot--visible { opacity: 1; }
.scene-shot--blend { transition: opacity 260ms ease-out, transform 340ms cubic-bezier(0.32, 0.72, 0, 1); }
.scene-shot--departing { opacity: 0; }
.branch-origin { position: absolute; z-index: 3; left: 32px; right: 32px; text-align: center; color: #aeb7b3; font-size: 13px; pointer-events: none; }
.fallback-anchor { position: absolute; left: 22px; right: 22px; text-align: center; z-index: 1; transition: transform 340ms cubic-bezier(0.32, 0.72, 0, 1); }
.fallback-anchor text { display: block; transform: translateY(-50%); font-size: 32px; line-height: 1.5; color: #edf3f3; }

.reading-layer { position: absolute; z-index: 2; left: 32px; right: 32px; opacity: 0; pointer-events: none; transition: opacity 220ms ease-out, transform 340ms cubic-bezier(0.32, 0.72, 0, 1); }
.reading-layer--visible { opacity: 1; pointer-events: auto; }
.reading-layer--waiting { pointer-events: none; }
.reading-scroll { width: 100%; }
.reading-context { display: block; margin-bottom: 18px; color: #8c999b; font-size: 14px; line-height: 1.8; }
.eyebrow { display: block; font-size: 12px; line-height: 1.6; letter-spacing: 0.8px; color: #879699; }
.reading-meaning { display: block; margin-top: 7px; font-size: 16px; line-height: 1.8; color: #b3bdbe; }
.reading-reflection { display: block; margin-top: 7px; font-size: 17px; line-height: 1.85; color: #e0e6e5; }
.reading-layer .current-seed { display: flex; align-items: baseline; gap: 10px; width: 100%; min-height: 44px; text-align: left; margin: 0 0 12px; background: transparent; padding: 0; }
.current-seed .eyebrow { flex: 0 0 auto; }
.current-seed-text { display: block; flex: 1; min-width: 0; white-space: nowrap; text-overflow: ellipsis; overflow: hidden; font-size: 14px; line-height: 1.8; color: #b3bdbe; }
.reading-layer .thought-invitation { width: 100%; margin: 0; text-align: left; font-size: 13px; line-height: 1.8; padding: 12px 0; color: #aebcbd; background: transparent; }
.note-actions { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; padding: 6px 0 16px; }
.reading-layer .note-actions button { width: auto; margin: 0; padding: 0; min-height: 44px; font-size: 13px; line-height: 44px; color: #91a2a4; background: transparent; }
.reflection { margin-top: 17px; padding-bottom: 14px; }
.source-details { opacity: 0; transition: opacity 220ms ease-out; margin-top: 20px; padding-top: 24px; border-top: 1px solid rgba(255,255,255,0.09); }
.source-details--visible { opacity: 1; }
.source-heading { display: flex; align-items: baseline; gap: 12px; color: #c5d0d1; font-size: 17px; line-height: 1.8; }
.source-chapter { font-size: 12px; color: #849598; }
.source-fulltext { display: block; margin-top: 16px; color: #8f9a9c; font-size: 17px; line-height: 2; }
.source-selected { color: #edf3f3; }
.source-note { display: block; margin-top: 20px; font-size: 12px; line-height: 1.8; color: #7e8c8e; }
.passage-navigation { display: flex; justify-content: space-between; align-items: center; padding: 24px 0 14px; font-size: 11px; color: #98a7a9; }
.reading-layer .passage-navigation button { flex: 0 0 auto; width: auto; margin: 0; padding: 0; min-width: 66px; min-height: 44px; line-height: 44px; font-size: 12px; }
.passage-navigation text { flex: 0 0 auto; white-space: nowrap; letter-spacing: 2px; font-variant-numeric: tabular-nums; }

.footer { position: absolute; z-index: 4; bottom: 0; left: 30px; right: 30px; display: flex; justify-content: space-between; background: #000; opacity: 0; transform: translateY(4px); pointer-events: none; transition: opacity 200ms ease-out, transform 200ms ease-out; }
.footer--visible { opacity: 1; transform: translateY(0); pointer-events: auto; }
.text-button { min-width: 48px; min-height: 44px; font-size: 13px; letter-spacing: 1px; display: flex; align-items: center; justify-content: center; color: #abbabe; }
.footer .text-button { flex: 1; }
.footer .seed-control { justify-content: flex-start; }
.footer .source-control { justify-content: center; }
.footer .pause-control { justify-content: flex-end; color: #d5e1e3; }
.gesture-hint { position: absolute; z-index: 4; left: 0; width: 100%; text-align: center; font-size: 10px; letter-spacing: 1px; color: #808b8d; opacity: 0; pointer-events: none; transition: opacity 500ms ease-out; }
.gesture-hint--visible { opacity: 1; }
.arrival { position: absolute; z-index: 3; top: 46%; width: 100%; text-align: center; font-size: 12px; letter-spacing: 2px; color: #a5b6bc; }
.error-state { z-index: 5; background: #000; padding: 30px; }

.backdrop { position: absolute; inset: 0; z-index: 10; background: rgba(0,3,5,0.73); opacity: 0; transition: opacity 240ms ease-out; }
.backdrop--visible { opacity: 1; }
.sheet { position: absolute; z-index: 11; bottom: 0; left: 0; right: 0; padding: 22px 28px 34px; padding-bottom: calc(24px + env(safe-area-inset-bottom)); background: #0a0e11; border-top: 1px solid rgba(255,255,255,0.07); border-radius: 24px 24px 0 0; opacity: 0; transition: transform 320ms cubic-bezier(0.32, 0.72, 0, 1), opacity 240ms ease-out; }
.sheet--visible { opacity: 1; }
.sheet-heading { display: flex; justify-content: space-between; align-items: center; }
.close-sheet { font-size: 11px; min-height: 44px; min-width: 44px; line-height: 44px; text-align: right; color: #b4c6cf; }
.sheet-title { display: block; margin-top: 18px; font-size: 23px; letter-spacing: 1px; }
.seed-input { width: 100%; height: 94px; margin-top: 23px; color: #dbe7ed; font-size: 16px; line-height: 1.8; }
.input-placeholder { color: #7b929d; }
.suggestions { display: flex; flex-wrap: wrap; gap: 10px; margin: 4px 0 22px; }
.suggestions button { flex: 0 0 auto; width: auto; min-height: 38px; margin: 0; padding: 0 18px; font-size: 12px; line-height: 38px; color: #b9cdd6; border: 1px solid rgba(255,255,255,0.14); border-radius: 999px; }
.sheet .enter-flow { width: 100%; min-height: 48px; line-height: 48px; padding: 0 16px; background: #d2e4e8; color: #15222a; border: 1px solid transparent; border-radius: 6px; font-size: 14px; letter-spacing: 2px; }
.sheet .enter-flow.enter-flow--disabled { background: transparent; color: #91a2a4; border-color: rgba(255,255,255,0.16); }
.note-quote { display: block; margin: 18px 0 10px; font-size: 19px; line-height: 1.8; color: #e0e6e5; }
.note-caption { display: block; margin: 12px 0 18px; font-size: 12px; line-height: 1.8; color: #91a2a4; }
.note-error { display: block; margin: 12px 0; font-size: 14px; line-height: 1.8; color: #e0e6e5; }
.notes-scroll { height: 58vh; margin-top: 12px; }
.saved-note { padding: 20px 0; border-bottom: 1px solid rgba(255,255,255,0.08); }
.note-seed { display: block; font-size: 13px; color: #91a2a4; line-height: 1.8; }
.note-body { display: block; white-space: pre-wrap; font-size: 17px; line-height: 1.85; color: #e0e6e5; }
.notes-sheet .remove-note, .notes-sheet .undo-note { width: 100%; padding: 0; margin: 0; min-height: 44px; line-height: 44px; font-size: 13px; color: #91a2a4; background: transparent; }
.notes-sheet .remove-note { text-align: right; margin-top: 8px; }

@media (max-height: 650px) {
  .reading-layer { left: 25px; right: 25px; }
  .reading-context { margin-bottom: 10px; }
  .reflection { margin-top: 10px; }
  .sheet { padding-top: 12px; }
  .seed-input { height: 70px; }
}
@media (prefers-reduced-motion: reduce) {
  .motion-preference { opacity: 0; }
  .scene-shot, .reading-layer, .footer, .gesture-hint, .source-details, .backdrop, .sheet, .fallback-anchor { transition-duration: 0.01ms; }
}

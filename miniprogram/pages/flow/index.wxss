.experience { position: relative; width: 100%; height: 100vh; overflow: hidden; background: #000; }
.ribbon { position: absolute; top: 0; left: 0; z-index: 0; width: 100%; height: 100%; }
.glyph-atlas { position: absolute; left: -10000px; top: 0; width: 2px; height: 2px; pointer-events: none; }

@keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes sheet-rise { from { transform: translateY(36px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

.footer { position: absolute; z-index: 4; bottom: 0; left: 30px; right: 30px; display: flex; justify-content: space-between; background: #000; animation: fade-in 260ms ease-out; }
.gesture-hint { position: absolute; z-index: 4; left: 0; width: 100%; text-align: center; font-size: 10px; letter-spacing: 2px; color: #666; pointer-events: none; animation: fade-in 600ms ease-out; }
.seed-control { min-width: 48px; }
.text-button { min-width: 48px; min-height: 44px; font-size: 11px; letter-spacing: 1px; display: flex; align-items: center; justify-content: center; color: #abbabe; }
.source-control { justify-content: flex-start; }
.pause-control { justify-content: flex-end; color: #d5e1e3; }
.footer .text-button { flex: 1; }
.footer .seed-control { justify-content: flex-start; }
.footer .source-control { justify-content: center; }

.arrival { position: absolute; z-index: 1; top: 41%; width: 100%; display: flex; flex-direction: column; align-items: center; }
.arrival-note { font-size: 12px; letter-spacing: 2px; color: #a5b6bc; margin-top: 22px; }
.error-state { z-index: 5; background: #050709; padding: 30px; }
.retry { margin-top: 12px; }

.still-reader { position: absolute; left: 32px; right: 32px; top: 28%; text-align: center; animation: fade-in 350ms ease-out; }
.still-quote { margin-top: 30px; }
.still-line { display: block; font-family: "Songti SC", "STSong", serif; font-size: 28px; line-height: 1.9; color: #edf3f3; }
.still-source { min-height: 44px; margin-top: 8px; font-family: "Songti SC", serif; font-size: 12px; line-height: 44px; color: #acbbc2; }
.still-source::before { content: ''; display: inline-block; width: 6px; height: 6px; margin-right: 9px; background: #a83a2e; vertical-align: 2px; }
.still-navigation { margin: 25px auto 0; max-width: 245px; display: flex; justify-content: space-between; align-items: center; font-size: 10px; color: #a5b7bd; }
.still-navigation button { min-width: 60px; min-height: 44px; line-height: 44px; }
.still-navigation text { flex: none; white-space: nowrap; margin: 0 12px; font-size: 11px; letter-spacing: 2px; color: #8ba1ab; }

.backdrop { position: absolute; inset: 0; z-index: 10; background: rgba(0,3,5,0.73); animation: fade-in 240ms ease-out; }
.sheet { position: absolute; z-index: 11; bottom: 0; left: 0; right: 0; padding: 22px 28px 34px; padding-bottom: calc(24px + env(safe-area-inset-bottom)); background: #0a0e11; border-top: 1px solid rgba(255,255,255,0.07); border-radius: 24px 24px 0 0; animation: sheet-rise 320ms cubic-bezier(0.32, 0.72, 0, 1); }
.sheet-heading { display: flex; justify-content: space-between; align-items: center; }
.eyebrow { display: block; color: #92aab6; font-size: 10px; letter-spacing: 2px; }
.close-sheet { font-size: 11px; min-height: 44px; min-width: 44px; line-height: 44px; text-align: right; color: #b4c6cf; }
.sheet-title { display: block; margin-top: 18px; font-family: "Songti SC", "STSong", serif; font-size: 23px; letter-spacing: 1px; }
.seed-input { width: 100%; height: 94px; margin-top: 23px; color: #dbe7ed; font-size: 16px; line-height: 1.8; font-family: "Songti SC", serif; }
.input-placeholder { color: #7b929d; }
.suggestions { display: flex; flex-wrap: wrap; gap: 10px; margin: 4px 0 22px; }
.suggestions button { flex: 0 0 auto; width: auto; min-height: 38px; margin: 0; padding: 0 18px; font-size: 12px; line-height: 38px; color: #b9cdd6; border: 1px solid rgba(255,255,255,0.14); border-radius: 999px; }
.enter-flow { min-height: 50px; line-height: 50px; background: #d2e4e8; color: #15222a; border-radius: 6px; font-size: 14px; letter-spacing: 4px; }
.enter-flow[disabled] { background: #25333b; color: #7b939e; }

.source-scroll { height: 52vh; margin: 12px 0; }
.source-title { display: block; font-family: "Songti SC", serif; font-size: 28px; margin-top: 12px; }
.source-chapter { display: block; color: #92aab6; margin-top: 9px; font-size: 12px; }
.source-fulltext { display: block; margin-top: 25px; font-family: "Songti SC", "STSong", serif; font-size: 18px; line-height: 2; color: #d8e3e8; }
.reflection-section { margin-top: 30px; padding: 24px 0 10px; border-top: 1px solid rgba(255,255,255,0.08); }
.source-reflection { display: block; font-family: "Songti SC", serif; font-size: 16px; line-height: 1.9; margin-top: 18px; color: #b5c9d2; }
.source-note { display: block; font-size: 10px; margin-top: 20px; line-height: 1.8; color: #829da9; }
.source-actions { display: flex; justify-content: space-between; border-top: 1px solid rgba(255,255,255,0.08); padding-top: 12px; }

@media (max-height: 650px) {
  .still-reader { top: 24%; }
  .still-quote { margin-top: 18px; }
  .still-navigation { margin-top: 8px; }
  .gesture-hint { margin-bottom: 10px; }
  .seed-sheet { padding-top: 12px; }
  .seed-input { height: 70px; }
}

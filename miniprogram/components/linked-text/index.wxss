@import "../../assets/fonts/classic.wxss";
@import "../../assets/fonts/system.wxss";
:host { display: inline; }
.linked-word { color: #f0f1ea; text-decoration: underline; text-decoration-color: #849b9c; text-underline-offset: 5px; padding: 10px 2px; }
.linked-word--pressed { color: #fff; text-decoration-color: #fff; background: rgba(255,255,255,.08); }
.source-selected { color: #ecf0ed; }
.classic-word { padding: 0; color: inherit; text-decoration: none; }
.classic-word.linked-word--pressed { color: #fff; background: rgba(255,255,255,.13); }

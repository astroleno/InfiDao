<text class="{{classic ? 'classic-text' : 'system-text'}}"><text wx:for="{{parts}}" wx:key="index" class="{{item.selected ? 'source-selected' : ''}} {{item.anchorId ? 'linked-word' : ''}} {{classic ? 'classic-word' : ''}} {{item.anchorId && item.anchorId === pressed ? 'linked-word--pressed' : ''}}" hover-class="{{item.anchorId && !busy ? 'linked-word--pressed' : 'none'}}" hover-stay-time="100" data-index="{{index}}" data-anchor="{{item.anchorId}}" catchtap="choose" aria-role="{{item.anchorId ? 'button' : 'text'}}" aria-label="{{item.anchorId ? '沿' + item.text + '展开经文' : item.text}}">{{item.text}}</text></text>

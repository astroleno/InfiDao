<text user-select="{{true}}"><text wx:for="{{parts}}" wx:key="index" class="{{item.selected ? 'source-selected' : ''}} {{item.anchorId ? 'linked-word' : ''}} {{item.anchorId && item.anchorId === pressed ? 'linked-word--pressed' : ''}}" hover-class="{{item.anchorId && !busy ? 'linked-word--pressed' : 'none'}}" hover-stay-time="100" data-anchor="{{item.anchorId}}" bindtap="choose" aria-role="{{item.anchorId ? 'button' : 'text'}}" aria-label="{{item.anchorId ? '沿' + item.text + '展开经文' : item.text}}">{{item.text}}</text></text>

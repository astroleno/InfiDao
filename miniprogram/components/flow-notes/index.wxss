.flow-notes { color: #d2d7d6; font-size: 17px; line-height: 1.95; }
.notes-origin { display: block; margin-bottom: 8px; font-size: 12px; letter-spacing: 0.8px; color: #879699; }
.linked-word { color: #f0f1ea; text-decoration: underline; text-decoration-color: #849b9c; text-underline-offset: 5px; padding: 10px 2px; }
.flow-notes--waiting .linked-word { color: #9aa5a5; }

{
  "name": "infidao",
  "version": "0.1.0",
  "description": "InfiDao 六经注我 - Interactive Knowledge Graph Platform with AI-Powered Search",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --ext .js,.mjs,.ts,.tsx src tests scripts --max-warnings=0",
    "lint:fix": "eslint --ext .js,.mjs,.ts,.tsx src tests scripts --fix --max-warnings=0",
    "type-check": "npm run type-check:app && npm run type-check:scripts",
    "type-check:app": "tsc --noEmit",
    "type-check:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:search-quality": "tsx scripts/compare-search-embeddings.ts --gate --check-artifact",
    "test:stability": "jest --runInBand --no-cache tests/unit/annotation/service.test.ts tests/integration/api/annotate.route.test.ts tests/unit/search/graph-store.test.ts tests/unit/search/graph-service.test.ts tests/unit/search/diagnostics.test.ts tests/unit/search/search-graph-generator.test.ts",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "clean": "rm -rf .next dist node_modules/.cache",
    "analyze": "cross-env ANALYZE=true next build",
    "generate-search-artifacts": "node scripts/generate-search-artifacts.mjs",
    "compare-search-embeddings": "tsx scripts/compare-search-embeddings.ts",
    "generate-search-graph": "tsx scripts/generate-search-graph.ts",
    "smoke:release": "node scripts/release-smoke.mjs",
    "smoke:telemetry": "node scripts/annotation-telemetry-smoke.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@next/bundle-analyzer": "^15.5.16",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.3.1",
    "framer-motion": "^11.11.17",
    "immer": "^10.1.1",
    "lucide-react": "^0.460.0",
    "next": "^15.5.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.2",
    "react-hotkeys-hook": "^4.5.1",
    "react-use": "^17.5.1",
    "recharts": "^2.13.3",
    "sharp": "^0.33.5",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.4",
    "uuid": "^10.0.0",
    "vaul": "^1.1.1",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/typography": "^0.5.15",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.16.13",
    "@types/react": "^18.3.13",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.20",
    "critters": "^0.0.23",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.16",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.13",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.15",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "tailwindcss": "^3.4.15",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "overrides": {
    "lodash": "^4.18.1",
    "postcss": "^8.5.15"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "keywords": [
    "knowledge-graph",
    "ai-search",
    "chinese-classics",
    "interactive-learning",
    "nextjs",
    "typescript",
    "tailwindcss"
  ],
  "author": "InfiDao Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/InfiDao/infidao"
  }
}

# Alibaba HTTPS gateway; the entire InfiDao runtime and compressed assets live on Tencent.
location ~* ^/InfiDao(?<infidao_public_suffix>/.*)?$ {
    return 308 /InfiDao$infidao_public_suffix$is_args$args;
}
location = /InfiDao {
    proxy_pass https://122.51.59.89;
    proxy_ssl_server_name on;
    proxy_ssl_name aitoshuu.art;
    proxy_ssl_verify on;
    proxy_ssl_verify_depth 3;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    proxy_http_version 1.1;
    proxy_set_header Host aitoshuu.art;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Connection "";
    proxy_cache off;
    proxy_redirect off;
    proxy_connect_timeout 10s;
    set $fv_cache_control "";
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_pass_header X-Accel-Buffering;
    proxy_read_timeout 240s;
    proxy_send_timeout 240s;
    gzip off;
}

      "compactSha256": "f112de28f84068e1de165e4afd79dcd854369e28d7546ff69c852769890171d2",
      "windowsSha256": "a0b3f02bba2be8184f981dd48f06b99df58148de2bb536424f62aa0140ded03d",
      "original": [
        {
          "sourceId": "rysxguji-mengzi-2-2",
          "textHash": "213c2b2e5863b48319a95165a631d5e95a2efaf177b5ab8ae1b063f6c46b49be",
          "quoteStart": 103,
          "quoteEnd": 113,
          "quote": "此无他，与民同乐也。"
        }
      ],
      "proposals": [
        {
          "sourceId": "rysxguji-mengzi-2-2",
          "textHash": "213c2b2e5863b48319a95165a631d5e95a2efaf177b5ab8ae1b063f6c46b49be",
          "quoteStart": 0,
          "quoteEnd": 51,
          "quote": "今王鼓乐於此，百姓闻王钟鼓之声，管籥之音，举欣欣然有喜色而相告曰：‘吾王庶几无疾病与，何以能鼓乐也？’"
        },
        {
          "sourceId": "rysxguji-mengzi-2-2",
          "textHash": "213c2b2e5863b48319a95165a631d5e95a2efaf177b5ab8ae1b063f6c46b49be",
          "quoteStart": 51,
          "quoteEnd": 103,
          "quote": "今王田猎於此，百姓闻王车马之音，见羽旄之美，举欣欣然有喜色而相告曰：‘吾王庶几无疾病与，何以能田猎也？’"
        },
        {
          "sourceId": "rysxguji-mengzi-2-2",
          "textHash": "213c2b2e5863b48319a95165a631d5e95a2efaf177b5ab8ae1b063f6c46b49be",
          "quoteStart": 103,
          "quoteEnd": 113,
          "quote": "此无他，与民同乐也。"
        }
      ],
